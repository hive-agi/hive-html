{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ;; hive-dsl — the Result the parser port returns.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.29"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.19"}}
          :ns-default hive-build.api}}}
